<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit settings. Run all tests with:  vendor/bin/phpunit
  Unit tests need nothing else. Feature tests need a MySQL server; the
  values below can be overridden with environment variables of the same name.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="TEST_DB_HOST" value="127.0.0.1" force="false"/>
        <env name="TEST_DB_PORT" value="3306" force="false"/>
        <env name="TEST_DB_NAME" value="campus_bridge_test" force="false"/>
        <env name="TEST_DB_USER" value="root" force="false"/>
        <env name="TEST_DB_PASSWORD" value="mysql" force="false"/>
    </php>
</phpunit>
