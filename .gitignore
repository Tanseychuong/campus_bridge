# ---------- backend (PHP) ----------
# Composer packages (install with: cd backend && composer install)
/backend/vendor/

# Personal settings with passwords — never commit
/backend/src/config.local.php
.env
.env.*
!.env.example

# PHPUnit cache
/backend/.phpunit.cache/
.phpunit.result.cache

# Files uploaded by students (kept out of Git)
/backend/storage/uploads/*
!/backend/storage/uploads/.gitkeep

# ---------- frontend (React) ----------
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/

# ---------- editors / operating systems ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
